---
import Base from '../layouts/Base.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <section id="hero" class="hero">
    <h1 class="name">Hassan Elshikh</h1>
    <div class="rule"></div>
		<div class="title-group">
		<h2 class= "title">
			Computer Engineer
		</h2>
		<div class="rule"></div>
		</div>
    <p class="subtitle">
      Embedded &nbsp;·&nbsp; FPGA &nbsp;·&nbsp; Neurotech
    </p>
    <div class="hero-contact">
      <Contact />
    </div>
  </section>

  <section id="about">
    <h2 class="section-label">About</h2>
    <p class="about-body">[ABOUT TEXT]</p>
  </section>

  <section id="neurotech">
    <h2 class="section-label">Neurotech</h2>
    <p class="neurotech-body">[NEUROTECH TEXT]</p>
  </section>

  <section id="projects">
    <h2 class="section-label">Projects</h2>
    <Projects />
  </section>

  <section id="skills">
    <h2 class="section-label">Skills</h2>
    <p class="skills-body">[SKILLS LIST]</p>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;

		gap: 0.75rem;
  }

  .name {
    font-size: clamp(1.6rem, 4.2vw, 3.2rem);
    font-weight: 300;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

	.title-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

  .rule {
    width: 500px;
    height: 0.75px;
    background: var(--rule);
    margin: 0.25rem auto;
  }

  .rule2 {
    width: 500px;
    height: 0.75px;
    background: var(--rule);
    /* margin: 0rem auto; */
  }

  .title {
    font-size: clamp(1rem, 2vw, 1.8rem);
    color: rgba(220, 165, 75, 0.78);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    line-height: 1.5;
  }

	.subtitle {
    font-size: clamp(0.7rem, 1.3vw, 0.85rem);
    color: rgba(220, 165, 75, 0.78);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    line-height: 1.5;
  }

  .hero-contact {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }


  .about-body,
  .neurotech-body,
  .skills-body {
    color: rgba(225, 175, 80, 0.86);
    font-size: 1rem;
    line-height: 1.9;
    max-width: 62ch;
  }

	.name,
	.title,
	.subtitle {
		margin: 0;
	}

</style>
