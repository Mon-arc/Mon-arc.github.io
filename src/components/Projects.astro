---
// Projects list — driven entirely by /src/data/projects.json.
// Each title links to its own detail page at /projects/{slug}/.
// Optional `image` field is shown as a thumbnail; `link` shows a teal ↗
// pointing to an external URL (github, demo, paper, etc).
import projects from '../data/projects.json';
---

<ol class="projects" role="list">
  {projects.map((p) => (
    <li class="project">
      <a class="thumb" href={`/projects/${p.slug}/`} aria-label={`${p.title} — details`}>
        {p.image ? (
          <img src={p.image} alt={p.title} loading="lazy" />
        ) : (
          <span class="thumb-placeholder" aria-hidden="true">{p.title.charAt(0)}</span>
        )}
      </a>

      <div class="body">
        <header>
          <h3 class="title">
            <a href={`/projects/${p.slug}/`}>{p.title}</a>
            {p.link && (
              <a class="ext" href={p.link} target="_blank" rel="noopener noreferrer" aria-label="External link">
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </h3>
          <span class="meta">
            {p.year && <span class="year">{p.year}</span>}
            <span class={`status status--${p.status}`}>{p.status}</span>
          </span>
          <span class="tags">{p.tags.join(' · ')}</span>
        </header>
        <p class="desc">{p.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .projects {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .project {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.75rem;
    align-items: start;
  }

  .thumb {
    display: block;
    width: 120px;
    height: 120px;
    border: 0.5px solid var(--rule);
    overflow: hidden;
    position: relative;
    transition: border-color 0.2s ease;
  }
  .thumb:hover {
    border-color: var(--accent);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .thumb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    font-weight: 300;
    color: var(--faint);
    letter-spacing: 0;
  }

  .body header {
    display: flex;
    align-items: baseline;
    gap: 1.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .title {
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--text-strong);
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .title > a {
    color: inherit;
    transition: color 0.18s ease;
  }
  .title > a:hover {
    color: var(--accent);
  }

  .ext {
    font-size: 1.5rem;
    line-height: 1;
    color: var(--accent);
    transform: translateY(-1px);
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .ext:hover {
    color: var(--text-strong);
    transform: translate(2px, -3px);
  }

  .meta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .year { color: var(--muted); }

  .status { font-weight: 400; }
  .status--ongoing { color: var(--text); }
  .status--ongoing::before {
    content: '●';
    font-size: 0.55rem;
    margin-right: 0.45rem;
    vertical-align: 1px;
    color: var(--text);
  }
  .status--complete { color: var(--accent); }
  .status--complete::before {
    content: '○';
    font-size: 0.6rem;
    margin-right: 0.4rem;
    vertical-align: 1px;
    color: var(--accent-soft);
  }

  .tags {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .desc {
    color: rgba(228, 178, 85, 0.85);
    font-size: 0.95rem;
    line-height: 1.75;
    max-width: 62ch;
  }

  @media (max-width: 767px) {
    .project {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .thumb {
      width: 100%;
      height: 200px;
    }
    .body header {
      gap: 0.85rem;
    }
    .tags {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
