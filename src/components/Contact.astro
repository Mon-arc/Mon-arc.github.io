---
// Contact: email shown as "user at domain" plain text + Copy email button.
// The address is assembled in JS at click time (not present in HTML source).
// To change the email: edit USER and DOMAIN in the inline script below.
---

<div class="contact">
  <p class="email" aria-label="Email address">
    <span class="user">hassan.elshikh</span>
    <span class="sep"> at </span>
    <span class="domain">torontomu.ca</span>
  </p>
  <button id="copy-email" class="copy-btn" type="button">
    <span class="label">Copy email</span>
  </button>
</div>

<style>
  .contact {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .email {
    font-size: 1.05rem;
    color: var(--text);
    letter-spacing: 0.08em;
  }
  .sep {
    color: var(--muted);
  }

  .copy-btn {
    background: transparent;
    border: 0.5px solid var(--rule);
    color: var(--text);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 0.7rem 1.4rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .copy-btn:hover {
    border-color: var(--text);
    color: var(--text-strong);
  }
  .copy-btn[data-copied='true'] {
    color: var(--accent);
    border-color: var(--accent-soft);
  }
</style>

<script is:inline>
  (() => {
    const USER = 'hassan.elshikh';
    const DOMAIN = 'torontomu.ca';
    const btn = document.getElementById('copy-email');
    const label = btn.querySelector('.label');
    const original = label.textContent;

    btn.addEventListener('click', async () => {
      const address = [USER, DOMAIN].join('@');
      try {
        await navigator.clipboard.writeText(address);
        label.textContent = 'Copied';
        btn.dataset.copied = 'true';
      } catch {
        label.textContent = 'Copy failed';
      }
      setTimeout(() => {
        label.textContent = original;
        delete btn.dataset.copied;
      }, 1600);
    });
  })();
</script>
