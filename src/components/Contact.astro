---
// Email + copy-on-click — the entire pill IS the button. Clicking anywhere
// on the email text copies the address. The address is assembled in JS at
// click time so no literal "@" appears in HTML source.
// To change the email: edit USER and DOMAIN in the inline script below.
---

<div class="contact">
  <button id="copy-email" class="copy-btn" type="button" aria-label="Copy email to clipboard">
    <span class="email" aria-hidden="true">
      <span class="user">hassan.elshikh</span><span class="sep"> [at] </span><span class="domain">torontomu.ca</span>
    </span>
    <span class="confirm" aria-hidden="true">Copied</span>
  </button>
</div>

<style>
  .contact {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .copy-btn {
    background: transparent;
    border: 0.75px solid var(--rule);
    color: var(--text);
    font-family: inherit;
    font-size: clamp(0.65rem, 1vw, 0.8rem);
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    padding: 0.9rem 1.6rem;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }
  /* Hovering anywhere on the button shifts color + border to teal. All
     children inherit color by default, so .user / .sep / .domain follow. */
  .copy-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .copy-btn[data-copied='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* [at] is dimmed via opacity instead of its own color, so it inherits
     whatever color the button currently has and shifts to teal on hover. */
  .sep {
    opacity: 0.55;
  }

  .confirm {
    display: none;
  }
  .copy-btn[data-copied='true'] .email {
    display: none;
  }
  .copy-btn[data-copied='true'] .confirm {
    display: inline;
  }
</style>

<script is:inline>
  (() => {
    const USER = 'hassan.elshikh';
    const DOMAIN = 'torontomu.ca';

    const btn = document.getElementById('copy-email');
    let timer = null;

    btn.addEventListener('click', async () => {
      const address = [USER, DOMAIN].join('@');
      try {
        await navigator.clipboard.writeText(address);
        btn.dataset.copied = 'true';
      } catch {
        btn.dataset.copied = 'failed';
      }
      clearTimeout(timer);
      timer = setTimeout(() => {
        delete btn.dataset.copied;
      }, 1600);
    });
  })();
</script>
